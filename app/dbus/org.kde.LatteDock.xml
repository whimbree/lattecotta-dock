<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.kde.LatteDock">
    <method name="activateLauncherMenu">
    </method>
    <method name="quitApplication">
    </method>
    <method name="lifecycleState">
        <arg name="state" type="s" direction="out"/>
    </method>
    <method name="setAutostart">
        <arg name="enabled" type="b" direction="in"/>
    </method>
    <method name="updateDockItemBadge">
        <arg name="identifier" type="s" direction="in"/>
        <arg name="value" type="s" direction="in"/>
    </method>
    <method name="windowColorScheme">
        <arg name="windowIdAndScheme" type="s" direction="in"/>
    </method>
    <method name="switchToLayout">
        <arg name="layout" type="s" direction="in"/>
    </method>
    <method name="importLayoutFile">
        <arg name="filepath" type="s" direction="in"/>
        <arg name="suggestedLayoutName" type="s" direction="in"/>
    </method>
    <method name="exportViewTemplate">
        <arg name="containmentId" type="u" direction="in"/>
    </method>
    <method name="addView">
        <arg name="containmentId" type="u" direction="in"/>
        <arg name="templateId" type="s" direction="in"/>
    </method>
    <method name="addApplet">
        <arg name="containmentId" type="u" direction="in"/>
        <arg name="pluginId" type="s" direction="in"/>
    </method>
    <method name="removeApplet">
        <arg name="containmentId" type="u" direction="in"/>
        <arg name="appletId" type="u" direction="in"/>
    </method>
    <method name="showWidgetExplorer">
        <arg name="containmentId" type="u" direction="in"/>
    </method>
    <method name="duplicateView">
        <arg name="containmentId" type="u" direction="in"/>
    </method>
    <method name="createLinkedView">
        <arg name="containmentId" type="u" direction="in"/>
        <arg name="screenId" type="i" direction="in"/>
        <arg name="edge" type="i" direction="in"/>
    </method>
    <!-- Debug-gated by LATTE_DEBUG_DBUS=1. Recreate the runtime window through
         the same path used after a custom indicator package changes.
         Persistent identity and configuration do not change; dockSystemData
         exposes the replacement runtimeViewId. -->
    <method name="reloadView">
        <arg name="containmentId" type="u" direction="in"/>
    </method>
    <method name="setViewPlacement">
        <arg name="containmentId" type="u" direction="in"/>
        <arg name="screenId" type="i" direction="in"/>
        <arg name="edge" type="i" direction="in"/>
        <arg name="alignment" type="i" direction="in"/>
    </method>
    <method name="moveViewToLayout">
        <arg name="containmentId" type="u" direction="in"/>
        <arg name="layoutName" type="s" direction="in"/>
    </method>
    <method name="removeView">
        <arg name="containmentId" type="u" direction="in"/>
    </method>
    <method name="setViewEditMode">
        <arg name="containmentId" type="u" direction="in"/>
        <arg name="editing" type="b" direction="in"/>
    </method>
    <method name="activateTaskAt">
        <arg name="containmentId" type="u" direction="in"/>
        <arg name="index" type="i" direction="in"/>
    </method>
    <method name="showSettingsWindow">
        <arg name="page" type="i" direction="in"/>
    </method>
    <method name="contextMenuData">
        <arg name="data" type="as" direction="out"/>
        <arg name="containmentId" type="u" direction="in"/>
    </method>
    <method name="viewAppletsOrder">
        <arg name="order" type="as" direction="out"/>
        <arg name="containmentId" type="u" direction="in"/>
    </method>
    <method name="viewDropMarkerIndex">
        <arg name="index" type="i" direction="out"/>
        <arg name="containmentId" type="u" direction="in"/>
    </method>
    <method name="viewTemplatesData">
        <arg name="data" type="as" direction="out"/>
    </method>
    <method name="viewsData">
        <arg name="data" type="s" direction="out"/>
    </method>
    <!-- Atomic schema-versioned all-docks topology/runtime snapshot. Schema 5
         added each visual view plus the coordinator-owned output-edge
         reservation groups and per-view stable floating-panel transition
         state. Transition rectangles retain QRectF precision. Schema 6 adds
         FP-3 (internal presentation, input, effects, and popup ownership),
         which outward-rasterizes the computed paint and input shapes into the
         live Effects values.
         appliedInputMask may temporarily retain the old union for one submitted
         clearing frame while event routing enforces the exact logical bridge.
         floatingDamageMaskPending names that exact interval and
         floatingDamageMaskGeneration is its process-local monotonic decimal
         string. enabledBorders reports the live Effects presentation.
         shadowEnabledBorders and shadowPaddingOffsets report the registered
         per-window KWindowShadow state; both are JSON null when no shadow is
         registered. floatingAppletPopupsPreferred
         reads Plasma's applied containment hint, and floatingAnchorRevision
         reports the live popup-anchor publication as a process-local
         monotonic decimal string. Schema 7 adds the per-view stable
         window-touch tracker, exact QRect role observation, raw pointer/wait
         inputs, derived attachment-deferral latch, presentation-independent
         positive floating-gap configuration, and separate legacy Dock
         maximized-gap request. The dockSystemData schema version is 7.
         The mandatory per-view transition geometry,
         surface publication, and layer-shell configure revisions are
         process-local monotonic decimal strings.
         reservationStateGeneration advances only after a complete projection
         transaction; each reservationGroups record names its actual output,
         edge, generation, contributorDockIds, maximum published depth,
         publisher identity, geometry and applied layer-shell state. Per-view
         reservationEdge and reservationGroupGeneration refer to that actual
         group, independently of snapshotSequence.

         Invalid clone lineage, transition ownership/state/geometry,
         reservation publication state, geometry, or view/group membership is
         logged and refused as an empty string, never returned as plausible
         partial JSON. An empty reservationGroups array at a newer
         reservationStateGeneration is the observable last-member teardown
         state. The stacking object deliberately reports available=false:
         inward same-edge stacking is not a supported placement model and
         stable overlap is not yet rejected, so canonical array order must
         never be interpreted as stack order. -->
    <method name="dockSystemData">
        <arg name="data" type="s" direction="out"/>
    </method>
    <!-- D21: each applet's JSON payload adds colorizerActive (the colorizer
         scheme is EFFECTIVELY pushed into the applet's own colour group) and
         colorizerReason (applied / notEngaged / splitter / selfColored /
         userBlocked / inlineFull). This is the whole decision, wider
         than colorizingBlocked (the user opt-out list only). Signature stays s
         (JSON string). See DbusReports::AppletRecord and
         AppletItem.colorizerPaletteActive. -->
    <method name="viewAppletsData">
        <arg name="data" type="s" direction="out"/>
        <arg name="containmentId" type="u" direction="in"/>
    </method>
    <method name="trackerData">
        <arg name="data" type="s" direction="out"/>
        <arg name="containmentId" type="u" direction="in"/>
    </method>
    <!-- G4: the per-task index + appId in the JSON payload ARE the
         window-task order readback (index is the model row, appId the stable
         per-window identity that travels across a reorder). Signature stays s
         (JSON string); no new argument. See docs/tracking/e2e-interaction-test-plan.md
         section 9 and DbusReports::TaskRecord. -->
    <method name="viewTasksData">
        <arg name="data" type="s" direction="out"/>
        <arg name="containmentId" type="u" direction="in"/>
    </method>
    <!-- SC-O1 (the read-only settings-control D-Bus registry): live fixture or
         future component registrations only. No setter, filter, registration,
         or execution method is public. -->
    <method name="viewSettingsControlsData">
        <arg name="data" type="s" direction="out"/>
        <arg name="containmentId" type="u" direction="in"/>
    </method>
    <!-- SC-T3 (the D29 narrow middle-click dispatch readback): selects the
         newest event across every current Latte Tasks applet in the requested
         containment. Any malformed nonempty candidate or duplicate process
         sequence refuses the aggregate as {}; an applet in Plasma's undo
         window remains current until actual destruction removes it from
         containment iteration. -->
    <method name="taskMiddleClickDispatchData">
        <arg name="data" type="s" direction="out"/>
        <arg name="containmentId" type="u" direction="in"/>
    </method>
    <!-- D21: the JSON payload adds the resolved applyColor/textColor/
         backgroundColor ("#rrggbb", "" when unresolved) and their
         applyColorBrightness/backgroundColorBrightness (0..255), so an applet
         contrast check can assert foreground-vs-background at the state level.
         Signature stays s (JSON string). See DbusReports::ColorizerRecord. -->
    <method name="colorizerData">
        <arg name="data" type="s" direction="out"/>
        <arg name="containmentId" type="u" direction="in"/>
    </method>
    <method name="viewConfigData">
        <arg name="data" type="s" direction="out"/>
        <arg name="containmentId" type="u" direction="in"/>
    </method>
    <method name="appletConfigData">
        <arg name="data" type="s" direction="out"/>
        <arg name="containmentId" type="u" direction="in"/>
        <arg name="appletId" type="u" direction="in"/>
    </method>
    <method name="layoutsData">
        <arg name="data" type="s" direction="out"/>
    </method>
    <method name="screensData">
        <arg name="data" type="s" direction="out"/>
    </method>
    <method name="setViewVisibilityMode">
        <arg name="containmentId" type="u" direction="in"/>
        <arg name="mode" type="s" direction="in"/>
    </method>
    <method name="setViewKeyboardNavigation">
        <arg name="containmentId" type="u" direction="in"/>
        <arg name="navigating" type="b" direction="in"/>
    </method>
    <method name="setViewConfiguringApplets">
        <arg name="containmentId" type="u" direction="in"/>
        <arg name="configuring" type="b" direction="in"/>
    </method>
    <method name="setBackgroundFromBroadcast">
        <arg name="activity" type="s" direction="in"/>
        <arg name="screenName" type="s" direction="in"/>
        <arg name="filename" type="s" direction="in"/>
    </method>
    <method name="setBroadcastedBackgroundsEnabled">
        <arg name="activity" type="s" direction="in"/>
        <arg name="screenName" type="s" direction="in"/>
        <arg name="enabled" type="b" direction="in"/>
    </method>
    <method name="toggleHiddenState">
        <arg name="layoutName" type="s" direction="in"/>
        <arg name="viewName" type="s" direction="in"/>
        <arg name="screenName" type="s" direction="in"/>
        <arg name="screenEdge" type="i" direction="in"/>
    </method>
  </interface>
</node>
